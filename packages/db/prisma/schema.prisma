generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? // nullable: doctor invite sets password later via accept-invite
  role         Role    @default(PATIENT)
  name         String
  phone        String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  inviteTokens        InviteToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime? // null = still valid; set when rotated or on logout

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // null = unused; set on redemption (single-use enforcement)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model InviteToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  acceptedAt DateTime? // null = pending

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("invite_tokens")
}
